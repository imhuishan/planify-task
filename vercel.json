{
  "version": 2,
  "builds": [
    {
      "src": "index.php",
      "use": "vercel-php@0.9.0"
    },
    {
      "src": "public/**/*.php",
      "use": "vercel-php@0.9.0"
    },
    {
      "src": "src/**/*.php",
      "use": "vercel-php@0.9.0"
    },
    {
      "src": "public/css/**/*.css",
      "use": "@vercel/static"
    },
    {
      "src": "public/js/**/*.js",
      "use": "@vercel/static"
    },
    {
      "src": "public/images/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
