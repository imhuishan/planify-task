{
  "version": 2,
  "functions": {
    "index.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "public/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    },
    "src/**/*.php": {
      "runtime": "vercel-php@0.9.0"
    }
  },
  "routes": [
    {
      "src": "/",
      "dest": "/public/index.php"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
